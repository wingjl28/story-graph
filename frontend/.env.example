# Leave VITE_COGNITO_AUTHORITY blank for local dev (auth disabled, matches backend with COGNITO_USER_POOL_ID unset).
# When set, full OIDC PKCE login is required and every API request includes an Authorization: Bearer header.

VITE_COGNITO_AUTHORITY=  # e.g. https://cognito-idp.<region>.amazonaws.com/<userPoolId>
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=  # optional; default = window.location.origin
VITE_COGNITO_SCOPE=  # optional; default "openid email profile"
